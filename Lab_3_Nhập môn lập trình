void Menu()
{
    int choice;

    do
    {
       

        printf("+====================================================+\n");
        printf("|                  MENU CHUONG TRINH                 |\n");
        printf("+====================================================+\n");
        printf("| 1. Tinh trung binh cac so chia het cho 2           |\n");
        printf("| 2. Kiem tra so nguyen to                           |\n");
        printf("| 3. Kiem tra so chinh phuong                        |\n");
        printf("| 4. Thoat chuong trinh                              |\n");
        printf("+====================================================+\n");

        printf("Nhap lua chon cua ban: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                function1();
                break;

            case 2:
                function2();
                break;

            case 3:
                function3();
                break;

            case 4:
                printf("Cam on ban da su dung chuong trinh!\n");
                break;

            default:
                printf("Lua chon khong hop le!\n");
                break;
        }

        

    } while (choice != 4);
}

void function1()
{
    int min, max, i;
    int dem = 0;
    float tong = 0, trungBinh = 0;

    printf("Nhap min: ");
    scanf("%d", &min);

    printf("Nhap max: ");
    scanf("%d", &max);

    if (min > max)
    {
        printf("Khoang gia tri khong hop le!\n");
        return;
    }

    i = min;

    while (i <= max)
    {
        if (i % 2 == 0)
        {
            tong += i;
            dem++;
        }

        i++;
    }

    if (dem == 0)
    {
        printf("Khong co so chan trong khoang nay!\n");
    }
    else
    {
        trungBinh = tong / dem;
        printf("Trung binh tong = %.2f\n", trungBinh);
    }
}

void function2()
{
    int x, i = 2;
    int count = 0;

    printf("Nhap x: ");
    scanf("%d", &x);

    if (x < 2)
    {
        printf("%d khong phai la so nguyen to\n", x);
        return;
    }

    while (i < x)
    {
        if (x % i == 0)
        {
            count++;
        }

        i++;
    }

    if (count == 0)
    {
        printf("%d la so nguyen to\n", x);
    }
    else
    {
        printf("%d khong phai la so nguyen to\n", x);
    }
}

void function3()
{
    int x, i = 0;

    printf("Nhap x: ");
    scanf("%d", &x);

    if (x < 0)
    {
        printf("%d khong phai la so chinh phuong\n", x);
        return;
    }

    while (i * i < x)
    {
        i++;
    }

    if (i * i == x)
    {
        printf("%d la so chinh phuong\n", x);
    }
    else
    {
        printf("%d khong phai la so chinh phuong\n", x);
    }
}
